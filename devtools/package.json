{
  "name": "tirtc-devtools-cli",
  "version": "0.4.1",
  "private": false,
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "tirtc-devtools-cli": "bin/tirtc-devtools-cli.js"
  },
